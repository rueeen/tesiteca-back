# ───────── Django ─────────
# Generar SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Producción: False
DEBUG=True
# Producción: USUARIO.pythonanywhere.com
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Santiago

# ───────── Frontend / orígenes ─────────
# Producción: https://tesiteca.netlify.app
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Solo desarrollo sin proxy; en producción puede quedar vacío.
CORS_ALLOWED_ORIGINS=http://localhost:5173
WS_ALLOWED_ORIGINS=http://localhost:5173

# ───────── Seguridad HTTPS (producción) ─────────
# Producción: True
SECURE_COOKIES=False
# Producción: True o activar Force HTTPS en PythonAnywhere.
SECURE_SSL_REDIRECT=False
# Producción: 31536000 cuando HTTPS esté verificado.
SECURE_HSTS_SECONDS=0
# Vacío = REMOTE_ADDR. Solo detrás de Netlify: HTTP_X_NF_CLIENT_CONNECTION_IP
TRUSTED_IP_HEADER=

# ───────── JWT ─────────
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_NAME=tesiteca_refresh

# ───────── Correo ─────────
# Desarrollo: los correos se imprimen en la terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# PythonAnywhere CUENTA GRATUITA: solo Gmail.
# 1) Activar verificación en dos pasos de Google.
# 2) Cuenta Google → Seguridad → Contraseñas de aplicaciones.
# 3) Configurar EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend,
#    EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True.
#    EMAIL_HOST_USER=tesiteca.arica@gmail.com
#    EMAIL_HOST_PASSWORD: contraseña de aplicación de 16 caracteres, NO la clave normal.
#    DEFAULT_FROM_EMAIL=Biblioteca de Tesis INACAP <tesiteca.arica@gmail.com>
#    El remitente debe ser la misma cuenta.
# CUENTA PAGADA: puede usar el SMTP institucional, ej. smtp.office365.com:587 TLS.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Biblioteca de Tesis <no-reply@example.com>
# Además de la notificación en la app, enviar correo al aprobar/rechazar.
NOTIFICAR_POR_CORREO=False

# ───────── Notificaciones en tiempo real ─────────
# True solo al desplegar la app ASGI.
NOTIFICACIONES_WS=False
# Vacío = InMemoryChannelLayer: HTTP y WS deben correr en el MISMO proceso ASGI.
REDIS_URL=

# ───────── Archivos ─────────
PRIVATE_MEDIA_ROOT=./private_media
MAX_PDF_MB=30
MAX_MATERIAL_MB=50
ALLOWED_EMAIL_DOMAINS=inacapmail.cl,inacap.cl
SEED_ADMIN_EMAIL=
