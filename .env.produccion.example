# Generar: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=rvavalencia.pythonanywhere.com
TIME_ZONE=America/Santiago
APP_VERSION=

FRONTEND_URL=https://tesiteca.netlify.app
CSRF_TRUSTED_ORIGINS=https://tesiteca.netlify.app,https://rvavalencia.pythonanywhere.com
CORS_ALLOWED_ORIGINS=
WS_ALLOWED_ORIGINS=https://tesiteca.netlify.app

SECURE_COOKIES=True
SECURE_SSL_REDIRECT=True
# Activar tras verificar HTTPS. No habilita preload ni subdominios automáticamente.
SECURE_HSTS_SECONDS=31536000

# Mismo valor que TESITECA_PROXY_SECRET en Netlify.
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
NETLIFY_PROXY_SECRET=
NETLIFY_SITE_URL=https://tesiteca.netlify.app
EXIGIR_PROXY_NETLIFY=True

ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_NAME=tesiteca_refresh

# Cuenta gratuita: solo Gmail; requiere verificación en dos pasos y contraseña de aplicación.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Cuenta Gmail dedicada al sistema.
EMAIL_HOST_USER=
# Contraseña de aplicación de 16 caracteres, nunca la contraseña normal.
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
# Biblioteca de Tesis INACAP <la-misma-cuenta@gmail.com>
DEFAULT_FROM_EMAIL=
NOTIFICAR_APROBACION_POR_CORREO=False

NOTIFICACIONES_WS=False
REDIS_URL=

PRIVATE_MEDIA_ROOT=/home/rvavalencia/tesiteca-back/private_media
# Cuenta gratuita: 512 MiB totales y proxy con corte a 26 segundos.
MAX_PDF_MB=20
MAX_MATERIAL_MB=20
ALLOWED_EMAIL_DOMAINS=inacapmail.cl,inacap.cl
SEED_ADMIN_EMAIL=rvalencia@inacap.cl

# Estudiantes: publicaciones de su carrera en todas las sedes.
VISIBILIDAD_ENTRE_SEDES=True

# La lista blanca preaprueba; siempre se exige validar el correo.
PREAPROBACION_LISTA_BLANCA=True

# Privacidad: versiones de textos legales que debe validar INACAP.
POLITICA_PRIVACIDAD_VERSION=2026-11
AUTORIZACION_PUBLICACION_VERSION=2026-11
# Días de conservación; 0 desactiva la categoría. Inactivas excluye ADMIN.
RETENCION_LECTURAS_DIAS=365
RETENCION_SOLICITUDES_RECHAZADAS_DIAS=180
RETENCION_CUENTAS_INACTIVAS_DIAS=0
# Correo para ejercer derechos; lo define INACAP.
CONTACTO_PRIVACIDAD=
